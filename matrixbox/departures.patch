+# Lijnkleuren (Renfe/Trenitalia): hex -> paletindex 10..15, per lijstweergave opnieuw verdeeld
+_brand_slots = {}
+def _brand_index(hexcol):
+    if hexcol in _brand_slots: return _brand_slots[hexcol]
+    if len(_brand_slots) >= 6: return None
+    try: v = int(hexcol.lstrip("#"), 16)
+    except ValueError: return None
+    r, g, b = v >> 16 & 255, v >> 8 & 255, v & 255
+    # even helder als de rest van het scherm: felste kanaal = dat van de standaardkleur
+    top = (int(varinit.settings["brightness"]) + 1) * 50
+    m = max(r, g, b, 1)
+    color = (r * top // m, g * top // m, b * top // m)
+    idx = 10 + len(_brand_slots)
+    varinit.palette[idx] = color
+    try: varinit.overlay_palette[idx] = color
+    except: pass
+    _brand_slots[hexcol] = idx
+    return idx
+
+# Lange bestemmingen staan stil en lopen elke DEST_SCROLL_PAUSE seconden één keer helemaal rond
+DEST_SCROLL_PAUSE = 6
+
+def _mask_rect(bmp, x0, y0, x1, y1, value=9):
+    # Maakt de doorzichtige pixels (0) in dit vlak van de overlay ondoorzichtig zwart (palet-index 9 wordt
+    # nergens gezet en is dus zwart). Aanroepen NA het tekenen van lijn en minuten: renderstring schrijft
+    # ook de "uit"-pixels rond elke letter als 0, en die zouden een eerder getekend vlak weer doorzichtig maken.
+    # Zo blijft een scrollende bestemming netjes achter de lijn- en tijdkolom.
+    x0 = max(0, x0); y0 = max(0, y0); x1 = min(bmp.width, x1); y1 = min(bmp.height, y1)
+    for _yy in range(y0, y1):
+        for _xx in range(x0, x1):
+            if bmp[_xx, _yy] == 0: bmp[_xx, _yy] = value
+
