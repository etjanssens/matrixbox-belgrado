+def _mask_rect(bmp, x0, y0, x1, y1, value=9):
+    # Ondoorzichtig zwart vlak in de overlay (palet-index 9 wordt nergens gezet en is dus zwart;
+    # alleen index 0 is transparant). Houdt een scrollende bestemming achter de lijn- en tijdkolom.
+    x0 = max(0, x0); y0 = max(0, y0); x1 = min(bmp.width, x1); y1 = min(bmp.height, y1)
+    if x1 <= x0 or y1 <= y0: return
+    try:
+        import bitmaptools
+        bitmaptools.fill_region(bmp, x0, y0, x1, y1, value)
+    except ImportError:
+        for _yy in range(y0, y1):
+            for _xx in range(x0, x1): bmp[_xx, _yy] = value
+
