+
+# Bronnen zonder eigen lijnkleur (o.a. Zweden via T-Skylt) zouden allemaal grijs worden: dan een vaste
+# huiskleur per vervoerder, anders een vaste kleur afgeleid van de lijnnaam (elke lijn steeds dezelfde).
+_OPERATOR_COLORS = {
+    "SJ": "fff~000",  # zwart logo op wit
+}
+_FALLBACK_COLORS = ("0067b1", "00843d", "7a1f7c", "e87722", "008c95", "c8102e", "b38f00", "5b3f99")
+
+
+def _fallback_color(name):
+    name = str(name).strip()
+    if name in _OPERATOR_COLORS:
+        return _OPERATOR_COLORS[name]
+    h = 0
+    for c in name:
+        h = (h * 31 + ord(c)) & 0xFFFF
+    return _FALLBACK_COLORS[h % len(_FALLBACK_COLORS)]
 
 
