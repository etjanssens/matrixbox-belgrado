+def _pick(colors, line):
+    if not isinstance(colors, dict):
+        return colors
+    if line in colors:
+        return colors[line]
+    for key in colors:
+        if key.endswith("*") and len(key) > 1 and line.startswith(key[:-1]):
+            return colors[key]
+    return colors.get("*")
+
+
+def _fallback_color(row):
+    name = str(row[1]).strip()
+    color = _OPERATOR_COLORS.get("".join(_LOWER.get(c, c) for c in name.lower()))
+    stn = varinit.settings["stations"]["1"]
+    if not color and stn.get("country") == "se":
+        op = _SE_COLORS.get(stn.get("operator"), {})
+        mode = row[7] if len(row) > 7 else ""
+        color = _pick(op.get(mode), name) or _pick(op.get("*"), name)
+        if stn.get("operator") == "skane" and mode == "BUS" and name.isdigit() and int(name) >= 100:
+            color = "FEC900~000~"  # regionbuss
+    if color:
+        return color
+    h = 0
+    for c in name:
+        h = (h * 31 + ord(c)) & 0xFFFF
+    return _FALLBACK_COLORS[h % len(_FALLBACK_COLORS)]
+
